# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=secret
DB_NAME=ragchatbot

# RabbitMQ
RABBITMQ_URL=amqp://app:app123@localhost:5672
RABBITMQ_EXCHANGE=ingest.topic
RABBITMQ_IMAGE_QUEUE=ingest.image.queue
RABBITMQ_PDF_QUEUE=ingest.pdf.queue

# LLM — "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ANTHROPIC_BASE_URL=...

# Embeddings — currently only "openai" supported
EMBEDDING_PROVIDER=openai

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.com

# Web search
TAVILY_API_KEY=tvly-...

# Google SSO
# Configure http://localhost:3000/auth/google/callback as an Authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Generate a high-entropy value, e.g. `openssl rand -base64 48`.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=86400
# Optional: redirects here after login. The access token is returned in the URL fragment.
# AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/callback

PORT=3000
