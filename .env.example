# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=secret
DB_NAME=ragchatbot

# RabbitMQ
RABBITMQ_URL=amqp://app:app123@localhost:5672
RABBITMQ_EXCHANGE=ingest.topic
RABBITMQ_IMAGE_QUEUE=ingest.image.queue
RABBITMQ_PDF_QUEUE=ingest.pdf.queue

# Object storage — Cloudflare R2 (S3-compatible)
# Create an R2 API token with access to this bucket, then use its access key ID
# and secret access key below. Find the account ID in the Cloudflare dashboard.
OBJECT_STORAGE_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=rag-chatbot-uploads
OBJECT_STORAGE_ACCESS_KEY=your-r2-access-key-id
OBJECT_STORAGE_SECRET_KEY=your-r2-secret-access-key
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# LLM — "anthropic" or "openai"
LLM_PROVIDER=anthropic
# Optional. Defaults: claude-sonnet-4-6 (anthropic), gpt-4o (openai).
# Example: LLM_MODEL=gpt-5-mini
# LLM_MODEL=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ANTHROPIC_BASE_URL=...

# Embeddings — currently only "openai" supported
EMBEDDING_PROVIDER=openai

# Web search
TAVILY_API_KEY=tvly-...

# Google SSO
# Configure http://localhost:3000/auth/google/callback as an Authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Generate a high-entropy value, e.g. `openssl rand -base64 48`.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=86400
# Use a different high-entropy value from AUTH_JWT_SECRET.
RECEIPT_CURSOR_HMAC_SECRET=replace-with-a-different-long-random-secret
# Optional: redirects here after login. The access token is returned in the URL fragment.
# AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/callback

PORT=3000

# Cloudflare DDNS — create a scoped API token with Zone / DNS / Edit access
# and restrict it to the zone containing the domain below.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_DDNS_DOMAINS=app.example.com
# Leave false while the app is exposed directly on port 3000. Set true after
# configuring an HTTP/HTTPS reverse proxy on a Cloudflare-supported port.
CLOUDFLARE_DDNS_PROXIED=false
# Leave IPv6 updates disabled unless this server has a working public IPv6 address.
CLOUDFLARE_DDNS_IP6_PROVIDER=none
