                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            },
            "description": "Generated from cURL: curl http://localhost:3000/auth/me \\\n  -H \"Authorization: \""
          },
          "response": []
