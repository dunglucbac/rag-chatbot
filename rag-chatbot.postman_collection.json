    {
      "name": "Storage",
      "item": [
        {
          "name": "Request Pre-sign URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Upload target was created\", () => {\n  pm.expect(response.status).to.eql(\"success\");\n  pm.expect(response.data.uploadUrl).to.be.a(\"string\");\n  pm.expect(response.data.storageKey).to.be.a(\"string\");\n  pm.expect(response.data.uploadHeaders[\"Content-Type\"]).to.be.a(\"string\");\n  pm.expect(response.data.uploadHeaders[\"x-amz-meta-original-filename\"]).to.be.a(\"string\");\n});\n\npm.collectionVariables.set(\"uploadUrl\", response.data.uploadUrl);\npm.collectionVariables.set(\"storageKey\", response.data.storageKey);\npm.collectionVariables.set(\"uploadContentType\", response.data.uploadHeaders[\"Content-Type\"]);\npm.collectionVariables.set(\"uploadOriginalFilename\", response.data.uploadHeaders[\"x-amz-meta-original-filename\"]);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"originalFilename\", \"IMG_0961.HEIC\");\npm.collectionVariables.set(\"mimeType\", \"image/heic\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{Bearer TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalFilename\": \"{{originalFilename}}\",\n  \"mimeType\": \"{{mimeType}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/storage/upload-targets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "storage",
                "upload-targets"
              ]
            },
            "description": "Create a signed upload URL and storageKey. Set originalFilename and mimeType in the pre-request script to match the file you will select in R2 Upload."
          },
          "response": []
        },
        {
          "name": "R2 Upload",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{uploadContentType}}"
              },
              {
                "key": "x-amz-meta-original-filename",
                "value": "{{uploadOriginalFilename}}"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "{{uploadUrl}}",
              "host": [
                "{{uploadUrl}}"
              ]
            },
            "description": "After importing, select your file under Body > binary. Send the Content-Type and x-amz-meta-original-filename headers returned by Request Pre-sign URL exactly as provided. Do not use form-data. Run Request Pre-sign URL first, then this request, then Queue Uploaded File."
          },
          "response": []
        }
      ]
    },
