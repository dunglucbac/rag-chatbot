    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Ingest PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Upload returned a job ID\", () => {\n  pm.expect(response.data.job.id).to.be.a(\"string\").and.not.empty;\n});\n\npm.environment.set(\"jobId\", response.data.job.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{Bearer TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storageKey\": \"{{storageKey}}\",\n  \"originalFilename\": \"{{originalFilename}}\",\n  \"mimeType\": \"{{mimeType}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ingest/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "file"
              ]
            },
            "description": "Upload a PDF file to ingest into the vector store."
          },
          "response": []
        },
