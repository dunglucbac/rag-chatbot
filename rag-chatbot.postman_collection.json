    {
      "name": "Storage",
      "item": [
        {
          "name": "Request Pre-sign URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Upload target was created\", () => {\n  pm.expect(response.status).to.eql(\"success\");\n  pm.expect(response.data.uploadUrl).to.be.a(\"string\");\n  pm.expect(response.data.storageKey).to.be.a(\"string\");\n});\n\npm.collectionVariables.set(\"uploadUrl\", response.data.uploadUrl);\npm.collectionVariables.set(\"storageKey\", response.data.storageKey);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"originalFilename\", \"IMG_0961.HEIC\");\npm.collectionVariables.set(\"mimeType\", \"image/heic\");"
                ]
              }
            }
