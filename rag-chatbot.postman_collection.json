    {
      "name": "Chat",
      "item": [
        {
          "name": "New Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"A session ID was returned\", () => {\n  pm.expect(body.data.sessionId).to.be.a(\"string\").and.not.empty;\n});\n\npm.collectionVariables.set(\"sessionId\", body.data.sessionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{Bearer TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"what time is this\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "messages"
              ]
            },
            "description": "Generated from cURL: curl http://localhost:3000/auth/me \\\n  -H \"Authorization: \""
          },
          "response": []
        },
        {
          "name": "Current Session",
          "request": {
            "method": "POST",
