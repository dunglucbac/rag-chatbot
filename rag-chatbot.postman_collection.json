  "item": [
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Queue Uploaded File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Upload returned a job ID\", () => {\n  pm.expect(response.data.job.id).to.be.a(\"string\").and.not.empty;\n});\n\npm.environment.set(\"jobId\", response.data.job.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{Bearer TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storageKey\": \"{{storageKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Run after R2 Upload succeeds. Queue the uploaded object using storageKey from Request Pre-sign URL. The API reads the original filename and MIME type from object metadata. Older objects without filename metadata need a fresh upload."
          },
          "response": []
        },
        {
          "name": "Job Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingest/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Fetch the status of an ingestion job."
          },
          "response": []
        }
      ]
    },
